@page "/admin/manage-repcodes"
@attribute [Authorize(Roles = "Administrator")]
@using Dapper
@using Syncfusion.Blazor.Grids
@using FilterType = Syncfusion.Blazor.Grids.FilterType
@inject UserManager<ApplicationUser> UserManager
@inject IDbConnectionFactory DbConnectionFactory
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Manage RepCodes and Regions</h3>
    <button class="btn btn-outline-primary"
            @onclick="ShowRegistrationCodes">
        View Registration Codes
    </button>
</div>

<SfDialog Width="850px"
          IsModal="true"
          ShowCloseIcon="true"
          CloseOnEscape="true"
          Header="Agency Registration Codes"
          @bind-Visible="registrationCodeDialogVisible">
    <DialogTemplates>
        <Content>
            @if (registrationCodesLoading)
            {
                <p class="mb-0"><em>Loading registration codes...</em></p>
            }
            else if (!string.IsNullOrWhiteSpace(registrationCodesError))
            {
                <div class="alert alert-danger mb-0" role="alert">
                    @registrationCodesError
                </div>
            }
            else if (registrationCodes is null || registrationCodes.Count == 0)
            {
                <p class="mb-0">No registration codes were found.</p>
            }
            else
            {
                <SfGrid TValue="AgencyRegistrationCodeInfo"
                        DataSource="registrationCodes"
                        AllowSorting="true"
                        AllowFiltering="true"
                        Toolbar="@(new List<string>() { "Search" })"
                        Height="400">
                    <GridFilterSettings Type="FilterType.Excel" />
                    <GridColumns>
                        <GridColumn Field="RepCode"
                                    HeaderText="RepCode"
                                    Width="150" />
                        <GridColumn Field="RegistrationCode"
                                    HeaderText="Registration Code"
                                    Width="220" />
                        <GridColumn Field="Status"
                                    HeaderText="Status"
                                    Width="120" />
                        <GridColumn Field="ExpirationDate"
                                    HeaderText="Expiration Date"
                                    Type="ColumnType.Date"
                                    Format="MM/dd/yyyy"
                                    Width="150" />
                        <GridColumn HeaderText="Invitation" Width="145" AllowSorting="false" AllowFiltering="false">
                            <Template Context="ctx">
                                @{
                                    var registrationCode = (AgencyRegistrationCodeInfo)ctx;
                                }
                                @if (registrationCode.Status == "Active" && !string.IsNullOrWhiteSpace(registrationCode.RegistrationCode))
                                {
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@BuildInvitationMailto(registrationCode)"
                                       aria-label="Draft invitation for @registrationCode.RepCode">
                                        Draft email
                                    </a>
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            }
        </Content>
    </DialogTemplates>
</SfDialog>

@if (users is null)
{
    <p><em>Loading users...</em></p>
}
else
{
    <SfGrid TValue="UserWithEdit"
            @ref="Grid"
            DataSource="users"
            AllowSorting="true"
            AllowFiltering="true"
            Toolbar="@(new List<string>() { "Search" })"
            Height="500">
        <GridFilterSettings Type="FilterType.Excel" />

        <GridColumns>
            <GridColumn Field="Email" HeaderText="Email" Width="220" />
            <GridColumn Field="FirstName" HeaderText="First Name" Width="140" />
            <GridColumn Field="LastName" HeaderText="Last Name" Width="140" />
            <GridColumn Field="RepCode" HeaderText="Current RepCode" Width="140" />
            <GridColumn HeaderText="Update RepCode" Width="160">
                <Template Context="ctx">
                    @{
                        var u = (UserWithEdit)ctx;
                    }
                    <input class="form-control form-control-sm"
                           style="width: 120px;"
                           @bind="u.EditedRepCode" />
                </Template>
            </GridColumn>

            <GridColumn Field="Region" HeaderText="Current Region" Width="140" />
            <GridColumn HeaderText="Update Region" Width="180">
                <Template Context="ctx">
                    @{
                        var u = (UserWithEdit)ctx;
                    }
                    <div class="d-flex flex-column">
                        <input class="form-control form-control-sm"
                               style="width: 120px;"
                               @bind="u.EditedRegion" />
                        <button class="btn btn-sm btn-primary mt-1"
                                @onclick="() => SaveRepAndRegion(u)">
                            Save
                        </button>
                    </div>
                </Template>
            </GridColumn>

            <GridColumn Field="IsActive" HeaderText="Status" Width="110">
                <Template Context="ctx">
                    @{
                        var u = (UserWithEdit)ctx;
                    }
                    @(u.IsActive ? "Active" : "Inactive")
                </Template>
            </GridColumn>

            <GridColumn HeaderText="Actions" Width="220">
                <Template Context="ctx">
                    @{
                        var u = (UserWithEdit)ctx;
                    }
                    <button class="btn btn-sm @(u.IsActive ? "btn-danger" : "btn-success")"
                            @onclick="() => ToggleUserStatus(u)">
                        @(u.IsActive ? "Deactivate" : "Activate")
                    </button>

                    <AuthorizeView Roles="SuperUser">
                        <Authorized>
                            <button class="btn btn-sm btn-outline-danger ms-2"
                                    @onclick="() => DeleteUser(u)">
                                Delete
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private List<UserWithEdit>? users;
    private SfGrid<UserWithEdit>? Grid;
    private List<AgencyRegistrationCodeInfo>? registrationCodes;
    private bool registrationCodeDialogVisible;
    private bool registrationCodesLoading;
    private string? registrationCodesError;

    protected override async Task OnInitializedAsync()
    {
        var allUsers = UserManager.Users.ToList();
        users = allUsers
            .Select(u => new UserWithEdit
            {
                Id = u.Id,
                Email = u.Email,
                FirstName = u.FirstName,
                LastName = u.LastName,
                RepCode = u.RepCode,
                EditedRepCode = u.RepCode,
                Region = u.Region,
                EditedRegion = u.Region,
                IsActive = u.IsActive
            })
            .OrderByDescending(u => u.IsActive)
            .ThenBy(u => u.LastName)
            .ThenBy(u => u.RepCode)
            .ToList();
    }

    private async Task ShowRegistrationCodes()
    {
        registrationCodeDialogVisible = true;
        registrationCodesError = null;
        registrationCodesLoading = true;

        try
        {
            const string sql = @"
                SELECT
                    RepCode,
                    RegistrationCode,
                    IsActive,
                    ExpirationDate
                FROM dbo.AgencyRegistrationCodes
                ORDER BY
                    CASE
                        WHEN IsActive = 1
                         AND (ExpirationDate IS NULL OR ExpirationDate > GETUTCDATE())
                            THEN 0
                        ELSE 1
                    END,
                    RepCode,
                    RegistrationCode;";

            using var connection = DbConnectionFactory.CreateRepConnection();
            var rows = await connection.QueryAsync<AgencyRegistrationCodeInfo>(sql);
            registrationCodes = rows.ToList();
        }
        catch (Exception ex)
        {
            registrationCodes = null;
            registrationCodesError = $"Unable to load registration codes: {ex.Message}";
        }
        finally
        {
            registrationCodesLoading = false;
        }
    }

    private static string BuildInvitationMailto(AgencyRegistrationCodeInfo code)
    {
        const string subject = "Welcome to the Chapin Rep Portal";
        var regionInstruction = string.Equals(code.RepCode, "LAW", StringComparison.OrdinalIgnoreCase)
            ? " Select your Region, then click Register."
            : " Then click Register.";

        var body = string.Join("\r\n", new[]
        {
            "Hi,",
            "",
            "Welcome aboard!",
            "",
            "To get started with our Rep Portal, please register using your own email address. Each person has their own login, so there is no need to share one with others at your company.",
            "",
            "Go to https://www.chapinportal.com/ and click Register in the top right corner.",
            "",
            $"Enter your email address, a password, your first and last name, and {code.RegistrationCode} in the Registration Code box.{regionInstruction}",
            "",
            "You'll receive an email to confirm your account. Open it and follow the confirmation link to finish setting up your login.",
            "",
            "Let me know if you have any questions or run into any issues!",
            "",
            "Thanks,"
        });

        return $"mailto:?subject={Uri.EscapeDataString(subject)}&body={Uri.EscapeDataString(body)}";
    }

    private async Task SaveRepAndRegion(UserWithEdit user)
    {
        var targetUser = await UserManager.FindByIdAsync(user.Id!);
        if (targetUser is not null)
        {
            targetUser.RepCode = user.EditedRepCode;
            targetUser.Region = user.EditedRegion;

            var result = await UserManager.UpdateAsync(targetUser);
            if (result.Succeeded)
            {
                user.RepCode = user.EditedRepCode;
                user.Region = user.EditedRegion;
                await UserManager.UpdateSecurityStampAsync(targetUser);
                await (Grid?.Refresh() ?? Task.CompletedTask);
            }
        }
    }

    private async Task ToggleUserStatus(UserWithEdit user)
    {
        var targetUser = await UserManager.FindByIdAsync(user.Id!);
        if (targetUser is not null)
        {
            targetUser.IsActive = !targetUser.IsActive;
            var result = await UserManager.UpdateAsync(targetUser);
            if (result.Succeeded)
            {
                user.IsActive = targetUser.IsActive;
                await UserManager.UpdateSecurityStampAsync(targetUser);
                await (Grid?.Refresh() ?? Task.CompletedTask);
            }
        }
    }

    private async Task DeleteUser(UserWithEdit user)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {user.Email}?");
        if (!confirmed) return;

        var targetUser = await UserManager.FindByIdAsync(user.Id!);
        if (targetUser is not null)
        {
            var result = await UserManager.DeleteAsync(targetUser);
            if (result.Succeeded)
            {
                users!.Remove(user);
                await (Grid?.Refresh() ?? Task.CompletedTask);
                StateHasChanged();
            }
            else
            {
                Console.WriteLine("Failed to delete user:");
                foreach (var error in result.Errors)
                {
                    Console.WriteLine($" - {error.Description}");
                }
            }
        }
    }

    private class AgencyRegistrationCodeInfo
    {
        public string? RepCode { get; set; }
        public string? RegistrationCode { get; set; }
        public bool IsActive { get; set; }
        public DateTime? ExpirationDate { get; set; }

        public string Status => !IsActive
            ? "Inactive"
            : ExpirationDate.HasValue && ExpirationDate.Value <= DateTime.UtcNow
                ? "Expired"
                : "Active";
    }

    private class UserWithEdit
    {
        public string? Id { get; set; }
        public string? Email { get; set; }
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? RepCode { get; set; }
        public string? EditedRepCode { get; set; }
        public string? Region { get; set; }
        public string? EditedRegion { get; set; }
        public bool IsActive { get; set; }
    }
}
